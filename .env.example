# Скопируйте этот файл в ".env" и впишите свои данные
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
FROM_NAME=ProgForce
PORT=3000
# Адрес вашего сайта в интернете (для Google), например:
# SITE_URL=https://progforce.example.com

# Чат-бот (ключ берите на https://console.anthropic.com). Без ключа бот отвечать не будет.
ANTHROPIC_API_KEY=sk-ant-...
# CHAT_MODEL=claude-haiku-5-5

# Android-приложение (TWA). Заполните после первой сборки, см. mobile/ANDROID.md
# TWA_PACKAGE=com.progforce.app
# TWA_SHA256=AA:BB:CC:...   (SHA-256 отпечаток ключа подписи; можно несколько через запятую)
